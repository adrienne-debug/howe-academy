{"schema":1,"made":"2026-09-22","source":"HoweCurriculum/eic_tags/eic_iowa_bank.py","items":[{"id":"BC01","bank":"beginning","skill":"capitalization","lines":["Last summer we visited","my aunt in denver,","Colorado, for a week."],"answer":2,"fix":{"line":2,"text":"my aunt in Denver,"},"rule":"Names of cities are capitalized."},{"id":"BC02","bank":"beginning","skill":"capitalization","lines":["Every Tuesday after lunch,","dr. Patel checks on","the animals at the farm."],"answer":2,"fix":{"line":2,"text":"Dr. Patel checks on"},"rule":"A title like Dr. before a name is capitalized."},{"id":"BC03","bank":"beginning","skill":"capitalization","lines":["My brother and i","read Charlotte's Web","together before bed."],"answer":1,"fix":{"line":1,"text":"My brother and I"},"rule":"The word I is always capitalized."},{"id":"BC04","bank":"beginning","skill":"capitalization","lines":["The first day of fall","is in September, and","the leaves start to change."],"answer":4,"fix":null,"rule":"Clean. Seasons (fall) stay lowercase; months are capitalized."},{"id":"BC05","bank":"beginning","skill":"capitalization","lines":["We celebrate thanksgiving","in November with pie,","turkey, and cranberries."],"answer":1,"fix":{"line":1,"text":"We celebrate Thanksgiving"},"rule":"Holidays are capitalized."},{"id":"BC06","bank":"beginning","skill":"capitalization","lines":["Mom smiled and said,","\"we will leave for the","beach in one hour.\""],"answer":2,"fix":{"line":2,"text":"\"We will leave for the"},"rule":"The first word of a quotation is capitalized."},{"id":"BC07","bank":"beginning","skill":"capitalization","lines":["The Mississippi River","is one of the longest","rivers in north America."],"answer":3,"fix":{"line":3,"text":"rivers in North America."},"rule":"Names of continents are capitalized."},{"id":"BC08","bank":"beginning","skill":"capitalization","lines":["our class went to","the science museum","on a rainy afternoon."],"answer":1,"fix":{"line":1,"text":"Our class went to"},"rule":"The first word of a sentence is capitalized."},{"id":"BC09","bank":"beginning","skill":"capitalization","lines":["In the spring, we plant","tomatoes and beans in","the garden behind our house."],"answer":4,"fix":null,"rule":"Clean. Seasons and plain nouns (garden) stay lowercase."},{"id":"BC10","bank":"beginning","skill":"capitalization","lines":["My cousin lives in","Canada and speaks both","English and french."],"answer":3,"fix":{"line":3,"text":"English and French."},"rule":"Languages are capitalized."},{"id":"BC11","bank":"beginning","skill":"capitalization","lines":["captain Rosa steered","the ship past the rocks","and into the harbor."],"answer":1,"fix":{"line":1,"text":"Captain Rosa steered"},"rule":"A title right before a name is capitalized."},{"id":"BC12","bank":"beginning","skill":"capitalization","lines":["The library is closed","on memorial day, so we","will go on Tuesday instead."],"answer":2,"fix":{"line":2,"text":"on Memorial Day, so we"},"rule":"Holidays are capitalized."},{"id":"BC13","bank":"beginning","skill":"capitalization","lines":["Dear aunt Jen,","Thank you for the","wonderful birthday gift."],"answer":1,"fix":{"line":1,"text":"Dear Aunt Jen,"},"rule":"Aunt used with a name is capitalized."},{"id":"BC14","bank":"beginning","skill":"capitalization","lines":["My favorite planet is","Saturn because of its","beautiful rings."],"answer":4,"fix":null,"rule":"Clean. Planet names are capitalized."},{"id":"BC15","bank":"beginning","skill":"capitalization","lines":["The pacific Ocean is","the largest ocean on","our planet, Earth."],"answer":1,"fix":{"line":1,"text":"The Pacific Ocean is"},"rule":"Names of oceans are capitalized."},{"id":"BC16","bank":"beginning","skill":"capitalization","lines":["Mr. and Mrs. Lopez","invited us to a party","on the first friday in May."],"answer":3,"fix":{"line":3,"text":"on the first Friday in May."},"rule":"Days of the week are capitalized."},{"id":"BC17","bank":"beginning","skill":"capitalization","lines":["When the bell rang,","the students lined up","quietly by the door."],"answer":4,"fix":null,"rule":"Clean. Nothing here is a name."},{"id":"BC18","bank":"beginning","skill":"capitalization","lines":["Our dog, pepper, loves","to chase squirrels","around the backyard."],"answer":1,"fix":{"line":1,"text":"Our dog, Pepper, loves"},"rule":"A pet's name is capitalized."},{"id":"BC19","bank":"beginning","skill":"capitalization","lines":["We read a story about","the statue of Liberty","in our history book."],"answer":2,"fix":{"line":2,"text":"the Statue of Liberty"},"rule":"Names of famous places are capitalized."},{"id":"BC20","bank":"beginning","skill":"capitalization","lines":["After dinner, i asked,","\"May I have another","slice of apple pie?\""],"answer":1,"fix":{"line":1,"text":"After dinner, I asked,"},"rule":"The word I is always capitalized."},{"id":"BC21","bank":"beginning","skill":"capitalization","lines":["The months of June,","july, and August are","the hottest in Texas."],"answer":2,"fix":{"line":2,"text":"July, and August are"},"rule":"Months are capitalized."},{"id":"BC22","bank":"beginning","skill":"capitalization","lines":["She wrote a report on","George Washington, the","first president."],"answer":4,"fix":null,"rule":"Clean. \"first president\" after the name stays lowercase."},{"id":"BC23","bank":"beginning","skill":"capitalization","lines":["My piano lesson is","every Monday at four","o'clock after school."],"answer":4,"fix":null,"rule":"Clean. Days are capitalized; school stays lowercase."},{"id":"BC24","bank":"beginning","skill":"capitalization","lines":["The Rocky Mountains","stretch from Canada","all the way to new Mexico."],"answer":3,"fix":{"line":3,"text":"all the way to New Mexico."},"rule":"Every word in a state's name is capitalized."},{"id":"BC25","bank":"beginning","skill":"capitalization","lines":["Every winter, the","birds fly south to","find warmer weather."],"answer":4,"fix":null,"rule":"Clean. Seasons and directions (south) stay lowercase."},{"id":"BC26","bank":"beginning","skill":"capitalization","lines":["Aunt Maria sent me","a postcard from","Paris, france."],"answer":3,"fix":{"line":3,"text":"Paris, France."},"rule":"Names of countries are capitalized."},{"id":"BC27","bank":"beginning","skill":"capitalization","lines":["My favorite book is","The secret Garden, and","I have read it twice."],"answer":2,"fix":{"line":2,"text":"The Secret Garden, and"},"rule":"The important words in a book title are capitalized."},{"id":"BC28","bank":"beginning","skill":"capitalization","lines":["We waited for","the bus on maple","Street in the rain."],"answer":2,"fix":{"line":2,"text":"the bus on Maple"},"rule":"Street names are capitalized."},{"id":"BC29","bank":"beginning","skill":"capitalization","lines":["The fourth of July","is a holiday with","fireworks and parades."],"answer":1,"fix":{"line":1,"text":"The Fourth of July"},"rule":"Every important word in a holiday's name is capitalized."},{"id":"BC30","bank":"beginning","skill":"capitalization","lines":["Lions and zebras","live on the grasslands","of africa."],"answer":3,"fix":{"line":3,"text":"of Africa."},"rule":"Names of continents are capitalized."},{"id":"BC31","bank":"beginning","skill":"capitalization","lines":["My teacher, Ms. Kim,","gave us extra recess","on Friday afternoon."],"answer":4,"fix":null,"rule":"Clean. Ms. with a name and Friday are capitalized."},{"id":"BC32","bank":"beginning","skill":"capitalization","lines":["the snow fell all","night long, and school","was closed the next day."],"answer":1,"fix":{"line":1,"text":"The snow fell all"},"rule":"The first word of a sentence is capitalized."},{"id":"BC33","bank":"beginning","skill":"capitalization","lines":["Yesterday Coach Diaz","told the team, \"practice","starts at noon.\""],"answer":2,"fix":{"line":2,"text":"told the team, \"Practice"},"rule":"The first word of a quotation is capitalized."},{"id":"BC34","bank":"beginning","skill":"capitalization","lines":["We learned that","Jupiter is the biggest","planet in our solar system."],"answer":4,"fix":null,"rule":"Clean. \"solar system\" stays lowercase."},{"id":"BC35","bank":"beginning","skill":"capitalization","lines":["On our trip to","Florida, we saw","Alligators in a swamp."],"answer":3,"fix":{"line":3,"text":"alligators in a swamp."},"rule":"Plain animal names are NOT capitalized."},{"id":"BC36","bank":"beginning","skill":"capitalization","lines":["The Amazon River","flows through the rain","forest of South America."],"answer":4,"fix":null,"rule":"Clean. River and continent names are capitalized."},{"id":"BC37","bank":"beginning","skill":"capitalization","lines":["We planted sunflowers","along the fence","last Spring."],"answer":3,"fix":{"line":3,"text":"last spring."},"rule":"Seasons are NOT capitalized."},{"id":"BC38","bank":"beginning","skill":"capitalization","lines":["We will see you soon.","your friend,","Maya"],"answer":2,"fix":{"line":2,"text":"Your friend,"},"rule":"The first word of a letter's closing is capitalized."},{"id":"BC39","bank":"beginning","skill":"capitalization","lines":["Is the pool open","on the last Monday","in may this year?"],"answer":3,"fix":{"line":3,"text":"in May this year?"},"rule":"Months are capitalized."},{"id":"BC40","bank":"beginning","skill":"capitalization","lines":["The Great Lakes are","between the United States","and canada."],"answer":3,"fix":{"line":3,"text":"and Canada."},"rule":"Names of countries are capitalized."},{"id":"BP01","bank":"beginning","skill":"punctuation","lines":["We packed sandwiches","apples, and juice","for the long hike."],"answer":1,"fix":{"line":1,"text":"We packed sandwiches,"},"rule":"Commas separate three or more things in a list."},{"id":"BP02","bank":"beginning","skill":"punctuation","lines":["Our school play is on","March 3 2027, and I","have the lead role."],"answer":2,"fix":{"line":2,"text":"March 3, 2027, and I"},"rule":"A comma goes between the day and the year."},{"id":"BP03","bank":"beginning","skill":"punctuation","lines":["Can we go to the","park after school","today, Dad."],"answer":3,"fix":{"line":3,"text":"today, Dad?"},"rule":"A question ends with a question mark."},{"id":"BP04","bank":"beginning","skill":"punctuation","lines":["The dog wagged its","tail and ran to","the front door."],"answer":4,"fix":null,"rule":"Clean. \"its\" (belonging to it) has no apostrophe."},{"id":"BP05","bank":"beginning","skill":"punctuation","lines":["I cant find my","shoes, and the bus","will be here soon."],"answer":1,"fix":{"line":1,"text":"I can't find my"},"rule":"A contraction needs an apostrophe (can't = can not)."},{"id":"BP06","bank":"beginning","skill":"punctuation","lines":["Wow, that was the","best fireworks show","I have ever seen"],"answer":3,"fix":{"line":3,"text":"I have ever seen!"},"rule":"Every sentence needs an end mark."},{"id":"BP07","bank":"beginning","skill":"punctuation","lines":["Our teacher said,","Please put your","books away.\""],"answer":2,"fix":{"line":2,"text":"\"Please put your"},"rule":"Quotation marks go around the exact words someone says."},{"id":"BP08","bank":"beginning","skill":"punctuation","lines":["The cats toy","rolled under the","couch in the den."],"answer":1,"fix":{"line":1,"text":"The cat's toy"},"rule":"An apostrophe shows something belongs to someone (the cat's toy)."},{"id":"BP09","bank":"beginning","skill":"punctuation","lines":["Yes, I finished my","homework before","dinner tonight."],"answer":4,"fix":null,"rule":"Clean. A comma follows Yes at the start."},{"id":"BP10","bank":"beginning","skill":"punctuation","lines":["We moved from","Austin, Texas, to","Portland Oregon."],"answer":3,"fix":{"line":3,"text":"Portland, Oregon."},"rule":"A comma goes between a city and its state."},{"id":"BP11","bank":"beginning","skill":"punctuation","lines":["The children played","tag, jumped rope, and","swung on the swings."],"answer":4,"fix":null,"rule":"Clean. The list of three actions has its commas."},{"id":"BP12","bank":"beginning","skill":"punctuation","lines":["Where did you put","the scissors","and the glue."],"answer":3,"fix":{"line":3,"text":"and the glue?"},"rule":"A question ends with a question mark."},{"id":"BP13","bank":"beginning","skill":"punctuation","lines":["Maria will you","help me carry","these boxes?"],"answer":1,"fix":{"line":1,"text":"Maria, will you"},"rule":"Use a comma after the name of the person you are talking to."},{"id":"BP14","bank":"beginning","skill":"punctuation","lines":["My sister's room","is painted blue","and mine is green."],"answer":2,"fix":{"line":2,"text":"is painted blue,"},"rule":"Use a comma before and when it joins two whole sentences."},{"id":"BP15","bank":"beginning","skill":"punctuation","lines":["It rained all","day so we stayed","inside and played games."],"answer":2,"fix":{"line":2,"text":"day, so we stayed"},"rule":"Use a comma before so when it joins two whole sentences."},{"id":"BP16","bank":"beginning","skill":"punctuation","lines":["The zoo has lions,","tigers bears, and","two baby giraffes."],"answer":2,"fix":{"line":2,"text":"tigers, bears, and"},"rule":"Commas separate the things in a list."},{"id":"BP17","bank":"beginning","skill":"punctuation","lines":["\"Look at that rainbow!","shouted Leo as he","ran to the window."],"answer":1,"fix":{"line":1,"text":"\"Look at that rainbow!\""},"rule":"Quotation marks go at the start AND the end of what someone says."},{"id":"BP18","bank":"beginning","skill":"punctuation","lines":["We don't have school","on Monday because","it is a holiday."],"answer":4,"fix":null,"rule":"Clean. don't has its apostrophe."},{"id":"BP19","bank":"beginning","skill":"punctuation","lines":["Dear Grandma","We miss you and","hope you visit soon."],"answer":1,"fix":{"line":1,"text":"Dear Grandma,"},"rule":"A comma goes after the greeting of a letter."},{"id":"BP20","bank":"beginning","skill":"punctuation","lines":["The kids' coats","were piled on the","bench by the door."],"answer":4,"fix":null,"rule":"Clean. kids' = the coats of more than one kid."},{"id":"BP21","bank":"beginning","skill":"punctuation","lines":["On July 4 1776,","the Declaration of","Independence was adopted."],"answer":1,"fix":{"line":1,"text":"On July 4, 1776,"},"rule":"A comma goes between the day and the year."},{"id":"BP22","bank":"beginning","skill":"punctuation","lines":["Please bring a pencil,","an eraser, and a","notebook to class"],"answer":3,"fix":{"line":3,"text":"notebook to class."},"rule":"Every sentence needs an end mark."},{"id":"BP23","bank":"beginning","skill":"punctuation","lines":["My friend lives at","12 Oak Street in","Dayton, Ohio."],"answer":4,"fix":null,"rule":"Clean. A comma sits between the city and the state."},{"id":"BP24","bank":"beginning","skill":"punctuation","lines":["Ben asked \"Is it","time to go home","yet?\""],"answer":1,"fix":{"line":1,"text":"Ben asked, \"Is it"},"rule":"Use a comma before a quotation (Ben asked, \"...)."},{"id":"BP25","bank":"beginning","skill":"punctuation","lines":["The baby birds","chirped loudly in","their nest,"],"answer":3,"fix":{"line":3,"text":"their nest."},"rule":"A sentence ends with an end mark, not a comma."},{"id":"BP26","bank":"beginning","skill":"punctuation","lines":["Were going to be","late if we don't","leave right now."],"answer":1,"fix":{"line":1,"text":"We're going to be"},"rule":"A contraction needs an apostrophe (we're = we are)."},{"id":"BP27","bank":"beginning","skill":"punctuation","lines":["We saw ducks, geese,","and swans at","the pond?"],"answer":3,"fix":{"line":3,"text":"the pond."},"rule":"A telling sentence ends with a period, not a question mark."},{"id":"BP28","bank":"beginning","skill":"punctuation","lines":["Hurry, or we will","miss the start","of the movie!"],"answer":4,"fix":null,"rule":"Clean. The comma after Hurry and the end mark are right."},{"id":"BP29","bank":"beginning","skill":"punctuation","lines":["Sam's bike has a","flat tire so he","walked to school."],"answer":2,"fix":{"line":2,"text":"flat tire, so he"},"rule":"Use a comma before so when it joins two whole sentences."},{"id":"BP30","bank":"beginning","skill":"punctuation","lines":["\"Do you want","to play outside?","asked my brother."],"answer":2,"fix":{"line":2,"text":"to play outside?\""},"rule":"Quotation marks go at the start AND the end of what someone says."},{"id":"BP31","bank":"beginning","skill":"punctuation","lines":["You may have a","cookie after you eat","your carrots Jake."],"answer":3,"fix":{"line":3,"text":"your carrots, Jake."},"rule":"Use a comma before the name of the person you are talking to."},{"id":"BP32","bank":"beginning","skill":"punctuation","lines":["We went to the","store the bank, and","the post office."],"answer":2,"fix":{"line":2,"text":"store, the bank, and"},"rule":"Commas separate the places in a list."},{"id":"BP33","bank":"beginning","skill":"punctuation","lines":["The teacher's desk","was covered with","papers and books."],"answer":4,"fix":null,"rule":"Clean. teacher's = the desk belongs to the teacher."},{"id":"BP34","bank":"beginning","skill":"punctuation","lines":["No, I havent seen","your jacket since","lunch today."],"answer":1,"fix":{"line":1,"text":"No, I haven't seen"},"rule":"A contraction needs an apostrophe (haven't = have not)."},{"id":"BP35","bank":"beginning","skill":"punctuation","lines":["What a beautiful day","it is for a picnic","at the park!"],"answer":4,"fix":null,"rule":"Clean. An exclamation fits this sentence."},{"id":"BP36","bank":"beginning","skill":"punctuation","lines":["They went to Chicago,","Illinois on","Friday, June 5."],"answer":2,"fix":{"line":2,"text":"Illinois, on"},"rule":"Put a comma after the state when the sentence keeps going."},{"id":"BP37","bank":"beginning","skill":"punctuation","lines":["Our puppy is","small fluffy, and","very playful."],"answer":2,"fix":{"line":2,"text":"small, fluffy, and"},"rule":"Commas separate the words in a list."},{"id":"BP38","bank":"beginning","skill":"punctuation","lines":["I think the answer","is seven, but I","am not sure?"],"answer":3,"fix":{"line":3,"text":"am not sure."},"rule":"A telling sentence ends with a period, not a question mark."},{"id":"BP39","bank":"beginning","skill":"punctuation","lines":["The mail carrier","left a package on","the porch for us"],"answer":3,"fix":{"line":3,"text":"the porch for us."},"rule":"Every sentence needs an end mark."},{"id":"BP40","bank":"beginning","skill":"punctuation","lines":["Watch out","for the puddle","on the sidewalk!"],"answer":4,"fix":null,"rule":"Clean. A warning can end with an exclamation point."},{"id":"LC01","bank":"level","skill":"capitalization","lines":["During the middle ages,","knights in Europe","trained for many years."],"answer":1,"fix":{"line":1,"text":"During the Middle Ages,"},"rule":"Names of historical periods are capitalized."},{"id":"LC02","bank":"level","skill":"capitalization","lines":["We drove north for","three hours to reach","the canadian border."],"answer":3,"fix":{"line":3,"text":"the Canadian border."},"rule":"Adjectives made from proper nouns (Canada → Canadian) are capitalized."},{"id":"LC03","bank":"level","skill":"capitalization","lines":["My family spent the","summer in the South,","visiting relatives in Georgia."],"answer":4,"fix":null,"rule":"Clean. The South as a region is capitalized; summer is not."},{"id":"LC04","bank":"level","skill":"capitalization","lines":["My older cousin is","studying Spanish and","Biology at college."],"answer":3,"fix":{"line":3,"text":"biology at college."},"rule":"School subjects are lowercase — except languages."},{"id":"LC05","bank":"level","skill":"capitalization","lines":["The Battle of Gettysburg","was a turning point","in the civil war."],"answer":3,"fix":{"line":3,"text":"in the Civil War."},"rule":"Names of wars are capitalized."},{"id":"LC06","bank":"level","skill":"capitalization","lines":["My mom and Aunt Rosa","are planning a trip","to the Grand Canyon."],"answer":4,"fix":null,"rule":"Clean. \"my mom\" stays lowercase; Aunt Rosa is a name."},{"id":"LC07","bank":"level","skill":"capitalization","lines":["Have you read Island","of the blue Dolphins","by Scott O'Dell?"],"answer":2,"fix":{"line":2,"text":"of the Blue Dolphins"},"rule":"Important words in a book title are capitalized."},{"id":"LC08","bank":"level","skill":"capitalization","lines":["When Mom gets home,","please tell her that","Dad called twice."],"answer":4,"fix":null,"rule":"Clean. Mom and Dad used as names are capitalized."},{"id":"LC09","bank":"level","skill":"capitalization","lines":["Last week my Dad","took us fishing at","a lake near the mountains."],"answer":1,"fix":{"line":1,"text":"Last week my dad"},"rule":"After my/his/her, dad is not a name — lowercase."},{"id":"LC10","bank":"level","skill":"capitalization","lines":["The Senate voted on","the new law after","a long debate."],"answer":4,"fix":null,"rule":"Clean. The Senate (a specific group) is capitalized."},{"id":"LC11","bank":"level","skill":"capitalization","lines":["We learned about the","ancient egyptians and","how they built pyramids."],"answer":2,"fix":{"line":2,"text":"ancient Egyptians and"},"rule":"Names of peoples and nationalities are capitalized."},{"id":"LC12","bank":"level","skill":"capitalization","lines":["The Red Cross sent","Volunteers to help","families after the flood."],"answer":2,"fix":{"line":2,"text":"volunteers to help"},"rule":"Plain nouns in the middle of a sentence are lowercase."},{"id":"LC13","bank":"level","skill":"capitalization","lines":["The president spoke","to reporters at the","White House on Monday."],"answer":4,"fix":null,"rule":"Clean. president without a name stays lowercase."},{"id":"LC14","bank":"level","skill":"capitalization","lines":["My favorite holiday is","Independence day because","of the fireworks."],"answer":2,"fix":{"line":2,"text":"Independence Day because"},"rule":"Every important word in a holiday's name is capitalized."},{"id":"LC15","bank":"level","skill":"capitalization","lines":["Our class read a poem","called \"The Road Not","taken\" by Robert Frost."],"answer":3,"fix":{"line":3,"text":"Taken\" by Robert Frost."},"rule":"Important words in a poem's title are capitalized."},{"id":"LC16","bank":"level","skill":"capitalization","lines":["The Sahara is the","largest hot desert","in the whole world."],"answer":4,"fix":null,"rule":"Clean. Sahara is a name; desert and world are not."},{"id":"LC17","bank":"level","skill":"capitalization","lines":["Every Fall, the","leaves in Vermont turn","red, orange, and gold."],"answer":1,"fix":{"line":1,"text":"Every fall, the"},"rule":"Seasons are not capitalized."},{"id":"LC18","bank":"level","skill":"capitalization","lines":["She was born in","Tokyo, Japan, but grew up","in the midwest."],"answer":3,"fix":{"line":3,"text":"in the Midwest."},"rule":"Regions of the country (the Midwest) are capitalized."},{"id":"LC19","bank":"level","skill":"capitalization","lines":["The Titanic sank in","the North Atlantic Ocean","in april of 1912."],"answer":3,"fix":{"line":3,"text":"in April of 1912."},"rule":"Months are capitalized."},{"id":"LC20","bank":"level","skill":"capitalization","lines":["The Nile River flows","north through Egypt","to the Mediterranean Sea."],"answer":4,"fix":null,"rule":"Clean. north is a direction here — lowercase."},{"id":"LC21","bank":"level","skill":"capitalization","lines":["My favorite author,","e. B. White, also wrote","Stuart Little."],"answer":2,"fix":{"line":2,"text":"E. B. White, also wrote"},"rule":"Initials in a name are capitalized."},{"id":"LC22","bank":"level","skill":"capitalization","lines":["Our team practiced","hard all Winter for","the spring tournament."],"answer":2,"fix":{"line":2,"text":"hard all winter for"},"rule":"Seasons are not capitalized."},{"id":"LC23","bank":"level","skill":"capitalization","lines":["The American Revolution","began in 1775 in","the colony of Massachusetts."],"answer":4,"fix":null,"rule":"Clean. colony stays lowercase before the name here."},{"id":"LC24","bank":"level","skill":"capitalization","lines":["The coach told us,","\"never give up,","no matter the score.\""],"answer":2,"fix":{"line":2,"text":"\"Never give up,"},"rule":"The first word of a quotation is capitalized."},{"id":"LC25","bank":"level","skill":"capitalization","lines":["We toured a French","bakery in New Orleans","on our spring break."],"answer":4,"fix":null,"rule":"Clean. French is from a proper noun; spring break is not a name."},{"id":"LC26","bank":"level","skill":"capitalization","lines":["My brother joined the","Boy Scouts, and he","loves Camping trips."],"answer":3,"fix":{"line":3,"text":"loves camping trips."},"rule":"Plain nouns are lowercase."},{"id":"LC27","bank":"level","skill":"capitalization","lines":["Martin Luther King Jr.","gave his famous speech","in washington, D.C."],"answer":3,"fix":{"line":3,"text":"in Washington, D.C."},"rule":"City names are capitalized."},{"id":"LC28","bank":"level","skill":"capitalization","lines":["The principal, Mrs.","Ortiz, announced that","School would close early."],"answer":3,"fix":{"line":3,"text":"school would close early."},"rule":"school is a plain noun here — lowercase."},{"id":"LC29","bank":"level","skill":"capitalization","lines":["The hawaiian Islands","are in the middle of","the Pacific Ocean."],"answer":1,"fix":{"line":1,"text":"The Hawaiian Islands"},"rule":"Every word in a place's name is capitalized."},{"id":"LC30","bank":"level","skill":"capitalization","lines":["Uncle Sam is a symbol","of the united States","and its government."],"answer":2,"fix":{"line":2,"text":"of the United States"},"rule":"Every word in a country's name is capitalized."},{"id":"LC31","bank":"level","skill":"capitalization","lines":["My science teacher,","Mr. Chen, showed us","a model of a rocket."],"answer":4,"fix":null,"rule":"Clean. science is a school subject — lowercase."},{"id":"LC32","bank":"level","skill":"capitalization","lines":["After world war II,","many soldiers returned","home to their families."],"answer":1,"fix":{"line":1,"text":"After World War II,"},"rule":"Names of wars are capitalized."},{"id":"LC33","bank":"level","skill":"capitalization","lines":["The Great wall of China","stretches for thousands","of miles across Asia."],"answer":1,"fix":{"line":1,"text":"The Great Wall of China"},"rule":"Every important word in a landmark's name is capitalized."},{"id":"LC34","bank":"level","skill":"capitalization","lines":["In the Book, the","main character sails","across the Atlantic."],"answer":1,"fix":{"line":1,"text":"In the book, the"},"rule":"book is a plain noun — lowercase."},{"id":"LC35","bank":"level","skill":"capitalization","lines":["Last Thanksgiving, my","grandmother made her","famous Pecan pie."],"answer":3,"fix":{"line":3,"text":"famous pecan pie."},"rule":"Foods are plain nouns — lowercase."},{"id":"LC36","bank":"level","skill":"capitalization","lines":["The Mayflower landed","at plymouth in 1620","after a long voyage."],"answer":2,"fix":{"line":2,"text":"at Plymouth in 1620"},"rule":"Place names are capitalized."},{"id":"LC37","bank":"level","skill":"capitalization","lines":["Our Choir sang the","national anthem at","the start of the game."],"answer":1,"fix":{"line":1,"text":"Our choir sang the"},"rule":"choir is a plain noun — lowercase."},{"id":"LC38","bank":"level","skill":"capitalization","lines":["The capital of Italy","is rome, a city","full of ancient ruins."],"answer":2,"fix":{"line":2,"text":"is Rome, a city"},"rule":"City names are capitalized."},{"id":"LC39","bank":"level","skill":"capitalization","lines":["I asked my Mother","if we could get","a puppy this year."],"answer":1,"fix":{"line":1,"text":"I asked my mother"},"rule":"After my/his/her, mother is not a name — lowercase."},{"id":"LC40","bank":"level","skill":"capitalization","lines":["We watched a Documentary","about the Wright brothers","and their first flight."],"answer":1,"fix":{"line":1,"text":"We watched a documentary"},"rule":"documentary is a plain noun — lowercase."},{"id":"LP01","bank":"level","skill":"punctuation","lines":["I have three goals","this year read more,","run faster, and sleep more."],"answer":2,"fix":{"line":2,"text":"this year: read more,"},"rule":"Use a colon after a complete sentence that introduces a list."},{"id":"LP02","bank":"level","skill":"punctuation","lines":["The storm knocked out","our power, we used","flashlights all night."],"answer":2,"fix":{"line":2,"text":"our power; we used"},"rule":"Two complete sentences can't be joined with just a comma — use a semicolon."},{"id":"LP03","bank":"level","skill":"punctuation","lines":["My neighbor, who is","a retired pilot tells","great stories."],"answer":2,"fix":{"line":2,"text":"a retired pilot, tells"},"rule":"Extra information set off by commas needs a comma on BOTH sides."},{"id":"LP04","bank":"level","skill":"punctuation","lines":["\"Are you coming","with us?\" asked","Jenna from the porch."],"answer":4,"fix":null,"rule":"Clean. The question mark goes inside the quotation marks."},{"id":"LP05","bank":"level","skill":"punctuation","lines":["The students' projects","were displayed in","the main hallway."],"answer":4,"fix":null,"rule":"Clean. students' = the projects of many students."},{"id":"LP06","bank":"level","skill":"punctuation","lines":["My sister, a talented","artist painted the","mural in our kitchen."],"answer":2,"fix":{"line":2,"text":"artist, painted the"},"rule":"An appositive (a talented artist) needs a comma on both sides."},{"id":"LP07","bank":"level","skill":"punctuation","lines":["Before the game","started, the coach","gave a short speech"],"answer":3,"fix":{"line":3,"text":"gave a short speech."},"rule":"Every sentence needs an end mark."},{"id":"LP08","bank":"level","skill":"punctuation","lines":["Did you read the","article \"Life on","Mars\" in the magazine?"],"answer":4,"fix":null,"rule":"Clean. The whole sentence is the question, so ? goes outside the quotes."},{"id":"LP09","bank":"level","skill":"punctuation","lines":["The well known author","signed copies of her","new book for fans."],"answer":1,"fix":{"line":1,"text":"The well-known author"},"rule":"Two words working as one describing word before a noun get a hyphen."},{"id":"LP10","bank":"level","skill":"punctuation","lines":["Dad asked, \"Who left","the gate open?\"","Nobody answered?"],"answer":3,"fix":{"line":3,"text":"Nobody answered."},"rule":"A telling sentence ends with a period."},{"id":"LP11","bank":"level","skill":"punctuation","lines":["We need the following","supplies glue, tape,","scissors, and markers."],"answer":2,"fix":{"line":2,"text":"supplies: glue, tape,"},"rule":"Use a colon after \"the following\" to introduce a list."},{"id":"LP12","bank":"level","skill":"punctuation","lines":["The men's locker room","is on the left, and the","womens is on the right."],"answer":3,"fix":{"line":3,"text":"women's is on the right."},"rule":"women's needs an apostrophe to show ownership."},{"id":"LP13","bank":"level","skill":"punctuation","lines":["However the bridge","was closed, so we","took the long way."],"answer":1,"fix":{"line":1,"text":"However, the bridge"},"rule":"Use a comma after an introductory word like However."},{"id":"LP14","bank":"level","skill":"punctuation","lines":["Ms. Park may I","borrow your stapler","for a minute?"],"answer":1,"fix":{"line":1,"text":"Ms. Park, may I"},"rule":"Use a comma after the name of the person you are talking to."},{"id":"LP15","bank":"level","skill":"punctuation","lines":["\"I'll finish my chores","first,\" said Owen \"and","then we can play.\""],"answer":2,"fix":{"line":2,"text":"first,\" said Owen, \"and"},"rule":"When a quotation is split, a comma comes after the speaker too."},{"id":"LP16","bank":"level","skill":"punctuation","lines":["The dog chased its","tail until it got","dizzy, and fell over."],"answer":3,"fix":{"line":3,"text":"dizzy and fell over."},"rule":"No comma between two verbs that share one subject (got dizzy and fell)."},{"id":"LP17","bank":"level","skill":"punctuation","lines":["Our towns parade","includes floats, bands,","and clowns."],"answer":1,"fix":{"line":1,"text":"Our town's parade"},"rule":"An apostrophe shows ownership (the town's parade)."},{"id":"LP18","bank":"level","skill":"punctuation","lines":["On May 1, 2025 the","new library opened","to the public."],"answer":1,"fix":{"line":1,"text":"On May 1, 2025, the"},"rule":"In the middle of a sentence, a comma goes after the year too."},{"id":"LP19","bank":"level","skill":"punctuation","lines":["I wanted to go;","however, it was","too late to leave."],"answer":4,"fix":null,"rule":"Clean. Semicolon before however, comma after it."},{"id":"LP20","bank":"level","skill":"punctuation","lines":["The recipe calls for","flour, sugar, eggs,","and a pinch of salt"],"answer":3,"fix":{"line":3,"text":"and a pinch of salt."},"rule":"Every sentence needs an end mark."},{"id":"LP21","bank":"level","skill":"punctuation","lines":["The two boy's bikes","were left out in","the rain overnight."],"answer":1,"fix":{"line":1,"text":"The two boys' bikes"},"rule":"More than one boy → the apostrophe goes after the s (boys')."},{"id":"LP22","bank":"level","skill":"punctuation","lines":["She whispered, \"Be","quiet. The baby","is sleeping."],"answer":3,"fix":{"line":3,"text":"is sleeping.\""},"rule":"Quotation marks go at the start AND the end of what someone says."},{"id":"LP23","bank":"level","skill":"punctuation","lines":["Tomatoes, which are","technically fruits, are","often used in salads."],"answer":4,"fix":null,"rule":"Clean. The extra information has a comma on both sides."},{"id":"LP24","bank":"level","skill":"punctuation","lines":["He was born on","June 12, 2013, in","San Diego California."],"answer":3,"fix":{"line":3,"text":"San Diego, California."},"rule":"A comma goes between a city and its state."},{"id":"LP25","bank":"level","skill":"punctuation","lines":["The team won the","championship; it was","the teams first title."],"answer":3,"fix":{"line":3,"text":"the team's first title."},"rule":"An apostrophe shows ownership (the team's title)."},{"id":"LP26","bank":"level","skill":"punctuation","lines":["My grandmother's","garden has roses, lilies,","and tulips?"],"answer":3,"fix":{"line":3,"text":"and tulips."},"rule":"A telling sentence ends with a period."},{"id":"LP27","bank":"level","skill":"punctuation","lines":["\"What time does","the movie start?\"","asked Priya."],"answer":4,"fix":null,"rule":"Clean. The question mark belongs inside the quotation marks."},{"id":"LP28","bank":"level","skill":"punctuation","lines":["We brought everything","we needed: tents, food,","and plenty of water."],"answer":4,"fix":null,"rule":"Clean. A colon after a complete sentence introduces the list."},{"id":"LP29","bank":"level","skill":"punctuation","lines":["Its paws were muddy,","so we washed the dog","before letting it inside."],"answer":4,"fix":null,"rule":"Clean. Its (belonging to it) has no apostrophe."},{"id":"LP30","bank":"level","skill":"punctuation","lines":["The movie was long;","nevertheless we enjoyed","every minute of it."],"answer":2,"fix":{"line":2,"text":"nevertheless, we enjoyed"},"rule":"Use a comma after nevertheless when it starts a clause."},{"id":"LP31","bank":"level","skill":"punctuation","lines":["My brother-in law","builds furniture in","his garage workshop."],"answer":1,"fix":{"line":1,"text":"My brother-in-law"},"rule":"brother-in-law takes two hyphens."},{"id":"LP32","bank":"level","skill":"punctuation","lines":["\"We won!\" shouted","the players as they","ran onto the field."],"answer":4,"fix":null,"rule":"Clean. The exclamation point goes inside the quotation marks."},{"id":"LP33","bank":"level","skill":"punctuation","lines":["The concert which","lasted three hours,","ended with fireworks."],"answer":1,"fix":{"line":1,"text":"The concert, which"},"rule":"Extra information set off by commas needs a comma on BOTH sides."},{"id":"LP34","bank":"level","skill":"punctuation","lines":["We're leaving at","noon; dont be late,","or you'll miss the bus."],"answer":2,"fix":{"line":2,"text":"noon; don't be late,"},"rule":"A contraction needs an apostrophe (don't = do not)."},{"id":"LP35","bank":"level","skill":"punctuation","lines":["The sign read,","\"No swimming after","dark."],"answer":3,"fix":{"line":3,"text":"dark.\""},"rule":"Quotation marks go at the start AND the end of the quoted words."},{"id":"LP36","bank":"level","skill":"punctuation","lines":["If you finish early","you may read quietly","or work on your project."],"answer":1,"fix":{"line":1,"text":"If you finish early,"},"rule":"Use a comma after an introductory clause (If you finish early,)."},{"id":"LP37","bank":"level","skill":"punctuation","lines":["Several student's","backpacks were left","in the gym."],"answer":1,"fix":{"line":1,"text":"Several students'"},"rule":"More than one student → the apostrophe goes after the s (students')."},{"id":"LP38","bank":"level","skill":"punctuation","lines":["The hike was long,","steep, and rocky but","the view was worth it."],"answer":2,"fix":{"line":2,"text":"steep, and rocky, but"},"rule":"Use a comma before but when it joins two complete sentences."},{"id":"LP39","bank":"level","skill":"punctuation","lines":["Please send the letter","to 45 Elm Road,","Austin, Texas 78701."],"answer":4,"fix":null,"rule":"Clean. No comma between the state and the ZIP code."},{"id":"LP40","bank":"level","skill":"punctuation","lines":["\"Wait for me!\"","called Nora running","to catch up."],"answer":2,"fix":{"line":2,"text":"called Nora, running"},"rule":"Use a comma before a phrase that describes the speaker (running to catch up)."}]}